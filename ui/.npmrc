# npm < 11.7 mislabels the platform binaries of sass/sass-embedded as peer deps and
# rewrites package-lock.json on every install; engine-strict turns that into a clear error.
engine-strict=true

# amis(6.x) peers react ^16 while we run react 18; mobx-react-lite@2.2.2 has the same stale peer.
# dsh Apps runtime needs mobx-react-lite hoisted at root for amis ESM imports to resolve.
legacy-peer-deps=true
