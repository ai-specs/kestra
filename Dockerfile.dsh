# dsh-monorepo 定制镜像（添加文件，不修改上游 Dockerfile）
#
# 阶段B（当前默认）：基于官方 kestra/kestra 镜像（内含 /app/kestra 二进制与官方插件），
# 叠加 docker/ 配置目录，并烘焙 locals/plugins/ 下本地构建的定制插件 jar。
# 每次执行 docker-compose build kestra 都会重新构建。
#
# 阶段B+（源码 SNAPSHOT，执行过 ./gradlew executableJar 后）：
#   docker build --build-arg BASE_IMAGE=ghcr.io/kestra-io/kestra-base:latest-no-plugins \
#                --build-arg EXECUTABLE=build/executable/kestra-<version> ...
# 见仓库根 README 或 dsh-monorepo 交付报告《源码构建方案》。
ARG BASE_IMAGE="kestra/kestra:v2.0.0-rc8"
FROM ${BASE_IMAGE}

USER root

COPY --chown=kestra:kestra docker /

# 烘焙本地构建的定制插件 jar（locals/plugins/*.jar，见 Makefile build-plugins 流程）
COPY --chown=kestra:kestra locals/plugins/ /app/plugins/

USER kestra

ENTRYPOINT ["docker-entrypoint.sh"]

CMD ["--help"]
